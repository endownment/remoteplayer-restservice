[Unit]
Description=remoteplayer REST API
Wants=network-online.target
After=network-online.target remoteplayer-mpv.service

[Service]
# The service reports readiness itself (sd_notify) once it is listening.
Type=notify
User=coop
# video: /dev/cec0 and vcgencmd; systemd-journal: GET /api/v1/player/log.
SupplementaryGroups=video systemd-journal
# No StateDirectory=: on a read-only root systemd could not create it, and the
# unit would fail to start. Settings and media live on /srv/remoteplayer.
ExecStart=/usr/local/bin/remoteplayer-restservice --config /etc/remoteplayer/restservice.toml
Restart=on-failure
RestartSec=2

# Sandboxing: the whole filesystem is read-only for this service except the
# writable partition. "-" lets the unit start without it (a fully read-only
# system); the service then refuses changes with a clear error. If you move
# the paths in the configuration, update ReadWritePaths (and ProtectHome when
# they are below /home).
ProtectSystem=strict
ReadWritePaths=-/srv/remoteplayer
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# PrivateDevices= is deliberately absent: it would hide /dev/cec0.

[Install]
WantedBy=multi-user.target
